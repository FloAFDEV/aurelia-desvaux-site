{
	"compilerOptions": {
		"lib": ["dom", "dom.iterable", "ES2020"],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"incremental": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "preserve",
		"forceConsistentCasingInFileNames": true,
		"plugins": [
			{
				"name": "next"
			}
		],
		"paths": {
			"@/*": ["./src/*"]
		},
		"target": "ES2020"
	},
	"include": [
		"next-env.d.ts",
		"src/**/*",
		".next/types/**/*.ts"
	],
	"exclude": ["node_modules"]
}
